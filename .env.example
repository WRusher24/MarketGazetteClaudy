# Copy to .env.local for local development. Set the same names in Vercel > Project > Settings > Environment Variables.

# Finnhub API key (https://finnhub.io/dashboard) - quotes, company profile, metrics, company news
FINNHUB_API_KEY=

# Google Gemini API key (https://aistudio.google.com/apikey) - AI summaries, analyst reports, sentiment
GEMINI_API_KEY=

# Neon PostgreSQL connection string (https://console.neon.tech)
DATABASE_URL=

# Optional: override the Gemini model (default: gemini-3.8-flash)
# GEMINI_MODEL=gemini-3.8-flash
